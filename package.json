{
    "name": "dokimosaic",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:mock": "vite --mode mock",
        "build": "vite build",
        "preview": "vite preview",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "test": "vitest",
        "test:ci": "vitest run --reporter=junit --outputFile=junit.xml",
        "tiles": "node scripts/generate-tiles.mjs",
        "tiles:upload": "node scripts/generate-tiles.mjs --upload"
    },
    "dependencies": {
        "papaparse": "^5.7.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1121.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "sharp": "^0.35.4",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.127.1"
    }
}
